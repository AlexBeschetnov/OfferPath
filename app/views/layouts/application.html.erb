<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · OfferPath" : "OfferPath" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="topbar__inner">
        <%= link_to "💼 OfferPath", root_path, class: "logo" %>

        <% if authenticated? %>
          <nav class="nav">
            <%= link_to "Dashboard", root_path, class: ("is-active" if current_page?(root_path)) %>
            <%= link_to "Board", board_job_applications_path, class: ("is-active" if current_page?(board_job_applications_path)) %>
            <%= link_to "Applications", job_applications_path, class: ("is-active" if current_page?(job_applications_path)) %>
          </nav>
          <div class="user-menu">
            <span><%= Current.user.email_address %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
          </div>
        <% end %>
      </div>
    </header>

    <main class="container">
      <% if notice %><div class="flash"><%= notice %></div><% end %>
      <% if alert %><div class="flash flash--alert"><%= alert %></div><% end %>

      <%= yield %>
    </main>
  </body>
</html>
